{
    "name": "tom32i/showcase-bundle",
    "description": "Showcase Bundle",
    "type": "symfony-bundle",
    "homepage": "https://github.com/Tom32i/ShowcaseBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Jarrand",
            "email": "thomas.jarrand@gmail.com",
            "homepage": "https://thomas.jarrand.fr"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tom32i\\ShowcaseBundle\\": ""
        }
    },
    "require": {
        "php": "^8.3",
        "league/glide": "^3.0",
        "league/glide-symfony": "^2.1",
        "symfony/finder": "^6.4|^7.0|^8.0",
        "symfony/filesystem": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "twig/twig": "^2.12|^3.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "ext-imagick": "Allow properties read/write on images"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "require-dev": {
        "ekino/phpstan-banned-code": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
